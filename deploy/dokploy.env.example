# Paste into the application's Environment tab in Dokploy. Do not commit filled-in values.

# 1 = demo mode: simulated chain state, burner wallet, no keys needed. Start here, then switch to a real cluster.
DEMO=1
# devnet or mainnet-beta (ignored in demo mode, which simulates mainnet)
CLUSTER=mainnet-beta
# The site's container port; Dokploy → Domains → Container Port must match. Defaults to 7310.
PORT=7310
# The exact public origin, no trailing slash. Token metadata URIs point at it.
PUBLIC_URL=https://recur.lol

# A paid RPC (Helius, Triton, QuickNode) for the backend. Indexing and holder reconciliation need getProgramAccounts.
RPC_URL=
# The RPC the browser uses for wallet transactions. Use a key restricted to your domain, never the backend's.
PUBLIC_RPC_URL=

# The three backend-controlled wallets: base58 secret key or a JSON byte array (quote it). Runtime variables only:
# never put them in Build-time Arguments. In demo mode leave them empty (demo wallets live on the data volume).
FEE_WALLET=
OTC_WALLET=
PROTECTION_WALLET=

# The platform token ($CUSHION), featured on the home page. No fees go to it.
MAIN_TOKEN_MINT=
JUPITER_API_KEY=
# Optional: pin coin images and metadata to IPFS instead of the data volume
PINATA_JWT=

# Continuous fee splits and Nest entry airdrops (defaults shown)
FEE_MIN_USD=2
FEES_EVERY_MS=15000
ENTRIES_EVERY_MS=20000
PRIORITY_MICROLAMPORTS=5000
