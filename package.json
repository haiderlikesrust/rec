{
  "name": "cook",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev:backend": "pnpm --filter @cook/backend dev",
    "dev:web": "pnpm --filter @cook/web dev",
    "demo": "pnpm --filter @cook/backend demo",
    "test": "pnpm --filter @cook/backend test",
    "typecheck": "pnpm -r typecheck"
