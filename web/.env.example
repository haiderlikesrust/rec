# Recur backend REST API
NEXT_PUBLIC_API_URL=http://localhost:42069
# mainnet-beta or devnet (must match the backend's CLUSTER)
NEXT_PUBLIC_CLUSTER=mainnet-beta
# Optional: your own RPC (the public endpoint is rate-limited); defaults to the cluster's public RPC
NEXT_PUBLIC_SOLANA_RPC=
# 1 = demo mode: adds a burner wallet; pair with a backend running DEMO=1
NEXT_PUBLIC_DEMO=
# Optional: pin launch images to IPFS via Pinata instead of saving them under public/uploads
PINATA_JWT=
