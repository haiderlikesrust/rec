# Indexer REST API (Ponder)
NEXT_PUBLIC_INDEXER_URL=http://localhost:42069
# 31337 = local anvil, 46630 = Robinhood Chain testnet, 4663 = Robinhood Chain mainnet
NEXT_PUBLIC_CHAIN_ID=31337
# Optional: WalletConnect Cloud project id (injected wallets work without it)
NEXT_PUBLIC_WC_PROJECT_ID=
# Optional: pin launch images to IPFS via Pinata instead of saving them under public/uploads
PINATA_JWT=
