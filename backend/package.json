{
  "name": "@cook/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "wallets": "tsx src/scripts/wallets.ts",
    "setup:configs": "tsx src/scripts/configs.ts",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "demo": "tsx src/demo.ts",
    "demo:reset": "node -e \"require('fs').rmSync('data/demo.db',{force:true});require('fs').rmSync('data/demo.db-wal',{force:true});require('fs').rmSync('data/demo.db-shm',{force:true})\""
  },
  "dependencies": {
    "@cook/shared": "workspace:*",
    "@coral-xyz/anchor": "^0.31.1",
    "@hono/node-server": "^1.19.5",
    "@meteora-ag/cp-amm-sdk": "1.5.1",
    "@meteora-ag/dynamic-bonding-curve-sdk": "2.0.0",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.99.0",
    "bn.js": "^5.2.1",
    "bs58": "^6.0.0",
    "dotenv": "^18.0.9",
    "hono": "^4.13.14",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.10.0",
    "typescript": "5.9.3"
  }
}
