# devnet or mainnet-beta (the web app's NEXT_PUBLIC_CLUSTER must match)
CLUSTER=devnet
# Your RPC (the public endpoints are rate-limited and often refuse getProgramAccounts)
RPC_URL=
PORT=42069
# Public URL of this backend: token metadata URIs point here unless PINATA_JWT is set
PUBLIC_URL=http://localhost:42069
PINATA_JWT=

# Backend-controlled wallets: base58 secret, JSON byte array, or a path to a keyfile.
# Leave empty to use data/wallets/<role>.json (create them with `pnpm --filter @gantry/backend wallets`).
# The fee wallet owns the platform's Raydium LaunchLab config: fund it with a little SOL, then run
# `pnpm --filter @gantry/backend setup:platform` once per cluster.
FEE_WALLET=
OTC_WALLET=
PROTECTION_WALLET=

# The platform token ($GANTRY), featured on the home page. No fees go to it.
MAIN_TOKEN_MINT=

# Jupiter (prices, quote <-> SOL conversions in the fee wallet, route checks); set a key for the paid host
JUPITER_API=https://lite-api.jup.ag
JUPITER_API_KEY=

# The address lookup table launches use, printed by setup:platform. The backend also remembers it in its database;
# setting it here keeps the same table when the database is replaced.
LOOKUP_TABLE=

# A quote takes launches while it has this much DEX liquidity and this many dollars of it sell into SOL on Jupiter
# within this price impact
MIN_LIQUIDITY_USD=5000
ROUTE_PROBE_USD=100
ROUTE_MAX_IMPACT_BPS=200

# Tuning
FEE_MIN_USD=5
PROTECTION_EVERY_MS=30000
PRIORITY_MICROLAMPORTS=50000

# DEMO=1 runs everything simulated in SQLite (or just use `pnpm demo`)
DEMO=
