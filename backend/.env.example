# devnet or mainnet-beta (the web app's NEXT_PUBLIC_CLUSTER must match)
CLUSTER=devnet
# Your RPC (the public endpoints are rate-limited and often refuse getProgramAccounts)
RPC_URL=
PORT=42069
# Public URL of this backend: token metadata URIs point here unless PINATA_JWT is set
PUBLIC_URL=http://localhost:42069
PINATA_JWT=

# Backend-controlled wallets: base58 secret, JSON byte array, or a path to a keyfile.
# Leave empty to use data/wallets/<role>.json (create them with `pnpm --filter @cook/backend wallets`).
FEE_WALLET=
OTC_WALLET=
PROTECTION_WALLET=
AIRDROP_WALLET=

# $RECR mint, once launched (SOL pair) through the app
MAIN_TOKEN_MINT=

# Jupiter (quote <-> SOL conversions in the fee wallet); set a key for the paid host
JUPITER_API=https://lite-api.jup.ag
JUPITER_API_KEY=

# Tuning
FEE_MIN_USD=5
MAIN_BUYBACK_MIN_SOL=0.25
PROTECTION_EVERY_MS=30000
CONFIG_DRIFT_BPS=1500
PRIORITY_MICROLAMPORTS=50000

# DEMO=1 runs everything simulated in SQLite (or just use `pnpm demo`)
DEMO=
